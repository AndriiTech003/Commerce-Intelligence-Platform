{
  "name": "@cip/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/seed.ts",
    "openapi:emit": "tsx src/openapi-emit.ts",
    "storage:setup": "tsx src/storage-setup.ts",
    "eval:creatives": "tsx src/eval-creatives.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@cip/contracts": "workspace:*",
    "@cip/messaging": "workspace:*",
    "@cip/observability": "workspace:*",
    "@clickhouse/client": "^1.23.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@node-rs/argon2": "^2.2.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "nodemailer": "^8.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5",
    "@ashamrai/flags-node": "file:../../vendor/ashamrai-flags-node-0.0.0.tgz",
    "@cip/personalization": "workspace:*"
  },
  "devDependencies": {
    "@cip/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/rabbitmq": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "amqplib": "^2.2.0",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "testcontainers": "^12.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "5.0.3",
    "ws": "^8.22.0"
  }
}
